@startuml cu_modulo_1_autenticacion
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam roundcorner 12
skinparam shadowing false
skinparam monochrome false
left to right direction

skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #2B2D42
    ArrowColor #2B2D42
    FontColor #2B2D42
}

skinparam actor {
    BackgroundColor #EDF2F4
    BorderColor #2B2D42
    FontColor #2B2D42
}

actor "Administrador" as Admin
actor "Vendedor" as Vendedor

rectangle "Sistema de Gestión — Autenticación y Seguridad" {
    usecase "Iniciar Sesión" as UC_Login
    usecase "Validar Credenciales" as UC_ValidarCred
    usecase "Bloquear Cuenta por Intentos Fallidos" as UC_BloquearCuenta
    usecase "Cerrar Sesión" as UC_Logout
    usecase "Gestionar Usuarios del Sistema" as UC_GestionUsuarios
    usecase "Crear Cuenta de Usuario" as UC_CrearUsuario
    usecase "Desactivar Cuenta de Usuario" as UC_DesactivarUsuario
    usecase "Restablecer Contraseña de Usuario" as UC_RestablecerPass
    usecase "Desbloquear Cuenta de Usuario" as UC_DesbloquearCuenta
    usecase "Consultar Lista de Usuarios" as UC_ListarUsuarios
}

Vendedor --> UC_Login
Vendedor --> UC_Logout

Admin --> UC_Login
Admin --> UC_Logout
Admin --> UC_GestionUsuarios

' Inclusiones
UC_Login ..> UC_ValidarCred : <<include>>
UC_GestionUsuarios ..> UC_ListarUsuarios : <<include>>

' Extensiones
UC_BloquearCuenta ..> UC_ValidarCred : <<extend>>
UC_CrearUsuario ..> UC_GestionUsuarios : <<extend>>
UC_DesactivarUsuario ..> UC_GestionUsuarios : <<extend>>
UC_RestablecerPass ..> UC_GestionUsuarios : <<extend>>
UC_DesbloquearCuenta ..> UC_GestionUsuarios : <<extend>>

@enduml
